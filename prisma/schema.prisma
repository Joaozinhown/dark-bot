generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Pool {
  id         Int          @id @default(autoincrement())
  guildId    String
  nome       String
  formato    String
  ativa      Boolean      @default(true)
  criadoEm   DateTime     @default(now())
  mapas      PoolMapa[]
  killers    PoolKiller[]
  confrontos Confronto[]

  @@unique([id, guildId])
}

model GuildConfig {
  guildId           String   @id
  adminRoleIds      String   @default("[]")
  scriptRoleIds     String   @default("[]")
  scriptUserIds     String   @default("[]")
  scriptAccessById  String?
  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt
}

model PoolMapa {
  id     Int    @id @default(autoincrement())
  poolId Int
  pool   Pool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
  nome   String
  ordem  Int
}

model PoolKiller {
  id     Int    @id @default(autoincrement())
  poolId Int
  pool   Pool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
  nome   String
  ordem  Int
}

model Confronto {
  id                 Int        @id @default(autoincrement())
  guildId            String
  poolId             Int
  pool               Pool       @relation(fields: [poolId], references: [id])
  formato            String
  timeARoleId        String
  timeBRoleId        String
  timeAVitorias      Int        @default(0)
  timeBVitorias      Int        @default(0)
  status             String     @default("aguardando")
  currentSet         Int        @default(1)
  channelId          String?
  vozTimeAId         String?
  vozTimeBId         String?
  vencedor           String?
  primeiroKiller     String?
  encerradoEm        DateTime?
  motivoEncerramento String?
  criadoEm           DateTime   @default(now())
  sets               Set[]
  vetoState          VetoState?
}

model Set {
  id           Int       @id @default(autoincrement())
  confrontoId  Int
  confronto    Confronto @relation(fields: [confrontoId], references: [id])
  numero       Int
  vencedorTime String?
  mapaUsado    String?
  killerUsado  String?
  killerTime   String?
  jogadoEm     DateTime?
}

model VetoState {
  id               Int       @id @default(autoincrement())
  confrontoId      Int       @unique
  confronto        Confronto @relation(fields: [confrontoId], references: [id])
  tipo             String
  set              Int
  vezDe            String
  mapasRestantes   String
  killersRestantes String
  mapaEscolhido    String?
  killerEscolhido  String?
  messageId        String?
}

model Jogador {
  id         String
  guildId    String
  nome       String
  vitorias   Int    @default(0)
  derrotas   Int    @default(0)
  confrontos Int    @default(0)

  @@id([id, guildId])
}

model WebSession {
  id                    String    @id @default(cuid())
  userId                String
  username              String
  avatarHash            String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime
  csrfTokenHash         String
  criadoEm              DateTime  @default(now())
  atualizadoEm          DateTime  @updatedAt
  ultimoAcessoEm        DateTime  @default(now())
  revogadoEm            DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  guildId     String
  actorUserId String
  action      String
  entityType  String?
  entityId    String?
  details     String   @default("{}")
  criadoEm    DateTime @default(now())

  @@index([guildId, criadoEm])
  @@index([actorUserId, criadoEm])
}

model GuildCommandSetting {
  id              Int      @id @default(autoincrement())
  guildId         String
  commandName     String
  enabled         Boolean  @default(true)
  allowedRoleIds  String   @default("[]")
  updatedByUserId String
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@unique([guildId, commandName])
  @@index([guildId, enabled])
}

model CustomCommand {
  id                 Int                        @id @default(autoincrement())
  guildId            String
  stableKey          String
  sourceType         String                     @default("custom")
  factoryCommandName String?
  name               String
  description        String
  draftDefinition    String
  enabled            Boolean                    @default(true)
  status             String                     @default("draft")
  publishedVersionId Int?
  discordCommandId   String?
  createdByUserId    String
  updatedByUserId    String
  criadoEm           DateTime                   @default(now())
  atualizadoEm       DateTime                   @updatedAt
  versions           CustomCommandVersion[]
  interactions       CustomCommandInteraction[]

  @@unique([guildId, stableKey])
  @@unique([guildId, name])
  @@index([guildId, enabled])
  @@index([guildId, discordCommandId])
}

model CustomCommandVersion {
  id             Int                        @id @default(autoincrement())
  commandId      Int
  command        CustomCommand              @relation(fields: [commandId], references: [id], onDelete: Cascade)
  version        Int
  definition     String
  publishedById String
  criadoEm       DateTime                   @default(now())
  interactions   CustomCommandInteraction[]

  @@unique([commandId, version])
  @@index([commandId, criadoEm])
}

model CustomCommandInteraction {
  token            String               @id
  guildId          String
  commandId        Int
  command          CustomCommand        @relation(fields: [commandId], references: [id], onDelete: Cascade)
  commandVersionId Int
  commandVersion   CustomCommandVersion @relation(fields: [commandVersionId], references: [id], onDelete: Cascade)
  nodeId           String
  contextJson      String               @default("{}")
  allowedUserId    String?
  expiresAt        DateTime
  consumedAt       DateTime?
  criadoEm         DateTime             @default(now())

  @@index([guildId, expiresAt])
  @@index([commandVersionId])
}
