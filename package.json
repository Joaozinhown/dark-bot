{
  "name": "dark-bot",
  "version": "1.0.0",
  "description": "Bot competitivo DBD — Queens Trials",
  "main": "build/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && npm run build:ts",
    "build:ts": "tsc",
    "test": "npm run build:ts && node --test build/systems/veto-rules.test.js",
    "start": "node scripts/start.js",
    "start:bot-hosting": "npm start",
    "deploy:discloud": "discloud app up",
    "logs:discloud": "discloud app logs",
    "deploy": "tsx src/deploy-commands.ts",
    "postinstall": "node -e \"const fs=require('fs'); if (fs.existsSync('prisma/schema.prisma')) require('child_process').execSync('npm run build',{stdio:'inherit'});\"",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "@types/node": "^22.10.0",
    "discord.js": "^14.27.0",
    "dotenv": "^16.4.0",
    "prisma": "^6.10.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0"
  }
}
